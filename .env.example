# Copie para .env e preencha. O .env é ignorado pelo git.
# As três primeiras são obrigatórias — a API não sobe sem elas.

# ── Obrigatórias ──
# Origens permitidas no CORS, separadas por vírgula. Tem que bater com a origem
# exata do frontend — porta inclusive. 9080 é o painel e 4321 é o público, tanto
# em `bun run dev` quanto servindo o dist/. Em produção, some aqui o domínio da
# Vercel: é do navegador do cliente, naquele domínio, que a API é chamada.
ALLOWED_ORIGINS=http://localhost:9080,http://127.0.0.1:9080,http://localhost:4321,http://127.0.0.1:4321
# Chave do painel admin. Gere uma forte: openssl rand -base64 32
ADMIN_KEY=coloque-uma-chave-forte-aqui
# URL onde o painel de atendimento é servido (usada nos links dos e-mails).
PAINEL_BASE_URL=http://localhost:9080

# ── Banco ──
# No docker o compose já fixa /data/forms.db (volume). Isso aqui vale para
# rodar fora do container.
DB_PATH=/data/forms.db

# ── Tokens de acesso do cliente ──
TOKEN_TTL_HOURS=48

# ── SMTP (opcional) ──
# Sem SMTP_HOST, nenhum e-mail é enviado — a triagem funciona normalmente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Se vazio, usa SMTP_USER.
SMTP_FROM=
# Para onde vai a notificação de nova triagem.
NOTIFY_TO=

# ── Rate limit (por IP + rota) ──
RATE_LIMIT=10
RATE_LIMIT_WINDOW=60

# ── Dados de demonstração ──
# true popula um banco vazio com 3 clientes fictícios. Deixe false em produção.
SEED_DEMO=false
