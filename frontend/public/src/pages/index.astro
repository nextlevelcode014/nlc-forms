---
import Base from '../layouts/Base.astro';

const servicos = [
  {
    href: '/triagem-suporte.html',
    icone: '🛠',
    titulo: 'suporte técnico',
    descricao: 'Diagnóstico, limpeza, formatação, upgrades e outros',
  },
  {
    href: '/triagem-seguranca.html',
    icone: '🔐',
    titulo: 'segurança & privacidade',
    descricao: 'Proteção digital, 2FA, gerenciador de senhas, VPN',
  },
  {
    href: '/triagem-desenvolvimento.html',
    icone: '⚡',
    titulo: 'dev & automação',
    descricao: 'Sites, sistemas, automações e soluções sob medida',
  },
];
---

<Base titulo="NextLevelCode — Triagem">
  <div class="intro">
    <h1>triagem</h1>
    <p>Selecione o formulário correspondente ao serviço desejado.</p>
  </div>

  <nav class="cartoes">
    {
      servicos.map((servico) => (
        <a class="cartao" href={servico.href}>
          <span class="cartao__icone" aria-hidden="true">
            {servico.icone}
          </span>
          <span class="cartao__corpo">
            <span class="cartao__titulo">{servico.titulo}</span>
            <span class="cartao__descricao">{servico.descricao}</span>
          </span>
          <span class="cartao__seta" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }
  </nav>

  <p class="aviso">
    Você recebeu um link específico? Use ele diretamente — este é apenas um atalho.
  </p>
</Base>

<style>
  .cartoes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cartao {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s, background 0.15s, transform 0.15s;
  }

  .cartao:hover {
    border-color: var(--accent);
    background: var(--accent-quiet);
    transform: translateY(-1px);
  }

  .cartao:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .cartao__icone {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    font-size: 24px;
    background: var(--accent-quiet);
    border-radius: var(--radius);
  }

  .cartao__corpo {
    display: flex;
    flex-direction: column;
  }

  .cartao__titulo {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 600;
  }

  .cartao__descricao {
    color: var(--text-muted);
    font-size: 14px;
    margin-top: 0.2rem;
  }

  .cartao__seta {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 20px;
    transition: color 0.15s;
  }

  .cartao:hover .cartao__seta {
    color: var(--accent);
  }

  .aviso {
    margin-top: 2rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
  }
</style>
