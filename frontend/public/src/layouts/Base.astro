---
import { Font } from 'astro:assets';
import Cabecalho from '@nlc/shared/components/Cabecalho.astro';
import Rodape from '@nlc/shared/components/Rodape.astro';
import '@nlc/shared/styles/tokens.css';
import '@nlc/shared/styles/base.css';

interface Props {
  titulo: string;
  descricao?: string;
  /**
   * `site` tira o cartão centralizado e entrega a página inteira.
   *
   * O cartão é a forma certa para formulário: delimita uma tarefa, dá foco e
   * cabe numa coluna de leitura. Como página de apresentação ele fica errado —
   * vira uma folha flutuando num fundo escuro em vez de um site. A home é o
   * mesmo site institucional, só que no domínio do atendimento, e precisa
   * respirar de ponta a ponta.
   */
  modo?: 'formulario' | 'site';
}

const { titulo, descricao, modo = 'formulario' } = Astro.props;
const site = modo === 'site';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {descricao && <meta name="description" content={descricao} />}
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Formulários e acompanhamento carregam dado de cliente e não devem
         aparecer em busca. A home é a exceção: ela é a vitrine.

         Os dois caminhos importam: com `build.format: 'file'` o pathname da home
         na hora do build é `/index.html`, não `/`. Comparar só com `/` deixava a
         vitrine sair `noindex` no dist — a página que existe justamente para ser
         achada era a única que ninguém acharia. -->
    <meta
      name="robots"
      content={['/', '/index.html'].includes(Astro.url.pathname) ? 'index, follow' : 'noindex, nofollow'}
    />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
  </head>

  <body class:list={{ 'corpo--site': site }}>
    {
      site ? (
        <>
          <div class="faixa faixa--cabecalho">
            <div class="faixa__interno">
              <Cabecalho href="https://nextlevelcode.pro" />
            </div>
          </div>
          <main>
            <slot />
          </main>
          <div class="faixa faixa--rodape">
            <div class="faixa__interno">
              <Rodape />
            </div>
          </div>
        </>
      ) : (
        <>
          <main class="container">
            <Cabecalho href="https://nextlevelcode.pro" />
            <slot />
          </main>
          <Rodape />
        </>
      )
    }
  </body>
</html>
