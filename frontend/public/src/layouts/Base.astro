---
import { Font } from 'astro:assets';
import Cabecalho from '@nlc/shared/components/Cabecalho.astro';
import Rodape from '@nlc/shared/components/Rodape.astro';
import '@nlc/shared/styles/tokens.css';
import '@nlc/shared/styles/base.css';

interface Props {
  titulo: string;
  descricao?: string;
  /** Container mais largo, para a home. Os formulários seguem estreitos. */
  largo?: boolean;
}

const { titulo, descricao, largo = false } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {descricao && <meta name="description" content={descricao} />}
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Formulários e acompanhamento carregam dado de cliente e não devem
         aparecer em busca. A home é a exceção: ela é a vitrine. -->
    <meta name="robots" content={Astro.url.pathname === '/' ? 'index, follow' : 'noindex, nofollow'} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
  </head>

  <body>
    <main class:list={['container', { 'container--wide': largo }]}>
      <Cabecalho href="https://nextlevelcode.pro" />
      <slot />
    </main>
    <Rodape />
  </body>
</html>
