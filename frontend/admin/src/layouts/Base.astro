---
import { Font } from 'astro:assets';
import Cabecalho from '@nlc/shared/components/Cabecalho.astro';
import '@nlc/shared/styles/tokens.css';
import '@nlc/shared/styles/base.css';
import '../styles/admin.css';

interface Props {
  titulo: string;
  largo?: boolean;
}

const { titulo, largo = false } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Painel interno: nunca deve ser indexado, nem se vazar para fora da tailnet. -->
    <meta name="robots" content="noindex, nofollow" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
  </head>

  <body>
    <main class:list={['container', largo && 'container--wide']}>
      <Cabecalho>
        <span slot="extra" class="selo">Admin</span>
      </Cabecalho>
      <slot />
    </main>
  </body>
</html>
